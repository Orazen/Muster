# Build context sent to Docker — keep it small and hermetic.
# Only revision metadata is exposed to the read-only build-context mount.
# Git config (which may contain clone credentials), objects and logs stay out.
.git/**
!.git/HEAD
!.git/packed-refs
!.git/refs
.git/refs/**
!.git/refs/heads
!.git/refs/heads/**
.gitignore
node_modules
dist
dist-server
dist-electron
dist-companion
dist-native
release
build
electron
ios
cloudflare
docs
tools
.muster
.omb-scratch
.wrangler
.worktrees
*.log
.DS_Store
*.tsbuildinfo
mascot-preview.html
