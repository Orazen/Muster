{
  "name": "muster-mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "vendor/image-size"
  ],
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --runInBand",
    "test:image-size": "node --test vendor/image-size/test.mjs",
    "lint": "oxlint --config .oxlintrc.json .",
    "build:android": "eas build --platform android",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:metro-assets": "node scripts/verify-metro-assets.mjs",
    "verify:autolinking": "node --test plugins/with-companion-autolinking.test.cjs plugins/with-companion-agp.test.cjs",
    "prepare:toolchain": "node scripts/prepare-toolchain.mjs",
    "postinstall": "node scripts/prepare-toolchain.mjs"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules",
        "./node_modules/expo/node_modules"
      ]
    }
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.0",
    "expo-crypto": "~14.0.0",
    "expo-device": "~7.0.0",
    "expo-file-system": "~18.0.0",
    "expo-haptics": "~14.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "13.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "29.5.14",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "18.3.1",
    "babel-jest": "29.7.0",
    "babel-preset-expo": "12.0.12",
    "jest": "29.7.0",
    "oxlint": "1.86.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.0",
    "braces": "file:vendor/dependency-forks/braces-3.0.3-muster-security-v1.tgz",
    "node-forge": "file:vendor/dependency-forks/node-forge-1.4.0-muster-security-v1.tgz"
  },
  "overrides": {
    "braces": "$braces",
    "node-forge": "$node-forge",
    "argparse": "2.0.1",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "tar": "7.5.22",
    "@xmldom/xmldom@<0.8.15": "0.8.15",
    "postcss": "8.5.28",
    "uuid": "11.1.1"
  }
}
