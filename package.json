{
  "name": "muster",
  "private": true,
  "version": "1.23.3",
  "description": "A local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/Orazen/Muster",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orazen/Muster.git"
  },
  "author": {
    "name": "Tharun Ramagiri",
    "email": "ramagiritharun.in@gmail.com",
    "url": "https://ramagiritharun.in"
  },
  "license": "SEE LICENSE IN LICENSE",
  "desktopName": "com.muster.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "bin": {
    "muster": "cli/muster.mjs"
  },
  "engines": {
    "node": ">=23.4"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "oxlint .",
    "dev": "vite",
    "companion": "node --experimental-strip-types companion/src/index.ts",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "check:ci": "npm run typecheck && npx tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run && pnpm test:native-load && pnpm broker:test && pnpm test:updater && pnpm test:desktop-lifecycle && pnpm test:packaged-server",
    "test:native-load": "node scripts/prepare-native-fixture.mjs && vitest run --config tests-integration/vitest.config.ts",
    "test:desktop-lifecycle": "node --test electron/server-lifecycle.node-test.mjs",
    "test:updater": "node --test electron/updater-coordinator.node-test.mjs",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "bench:roles": "vitest run server/role-eval-harness.test.ts",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:shard": "vitest run --shard",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node --check electron/main.mjs && node --check electron/companion.mjs && node --check electron/terminal-launch.mjs && node --check electron/preload.cjs && node --check electron/capabilities.cjs && node --check electron/cua-connection.cjs && node --check electron/cua.mjs && node --check electron/speech.mjs",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json && node scripts/bundle-server.mjs",
    "build:companion": "tsc -p tsconfig.companion.build.json",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:updater": "node scripts/bundle-updater.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:companion && pnpm build:updater",
    "package:mac": "pnpm package:mac:arm64",
    "package:mac:arm64": "pnpm package:prepare && pnpm build:speech && CUA_TARGET_ARCH=arm64 pnpm build:cua && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "pnpm package:prepare && pnpm build:speech && CUA_TARGET_ARCH=x64 pnpm build:cua && electron-builder --mac --x64 --publish never -c.dmg.artifactName=Muster-\\${version}-intel.dmg",
    "package:cli": "node scripts/build-cli.mjs",
    "package:win": "pnpm package:prepare && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && electron-builder --linux --x64 --publish never",
    "package:linux:dir": "pnpm package:prepare && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "broker:types": "wrangler types --config cloudflare/composio-broker/wrangler.jsonc cloudflare/composio-broker/worker-configuration.d.ts",
    "broker:check": "pnpm broker:types && tsc -p cloudflare/composio-broker/tsconfig.json",
    "broker:test": "vitest run --config cloudflare/composio-broker/vitest.config.ts",
    "broker:deploy": "wrangler deploy --config cloudflare/composio-broker/wrangler.jsonc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^1.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@trycua/cua-driver": "0.30.4",
    "better-auth": "^1.7.6",
    "better-sqlite3": "^13.0.3",
    "bot-avatars": "^0.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "jose": "6.2.12",
    "lucide-react": "^1.49.0",
    "posthog-js": "^1.435.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "undici": "8.11.2",
    "vaultgram": "github:tharunramagiri/vaultgram",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.11",
    "@trycua/cua-driver-darwin-x64": "0.30.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "node-gyp": "12.4.0",
    "oxlint": "1.86.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "4.144.0",
    "yaml": "2.9.1"
  }
}
